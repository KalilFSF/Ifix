# Ambiente virtual Python (cada dev cria o seu com `python -m venv venv`)
venv/
.venv/

# Cache/bytecode do Python
__pycache__/
*.pyc
*.pyo

# Arquivos locais de banco não fazem parte da aplicação MySQL/Aiven
backend/database/*.db

# Uploads de usuário (fotos de perfil, diplomas) — conteúdo gerado em
# runtime, não faz parte do código. Em produção os uploads usam Cloudinary.
frontend/uploads/*

# Claude Code (assistente de IA usado no desenvolvimento) — configs e
# histórico locais, não fazem parte do código do projeto
.claude/

# Sistema operacional / editor
.DS_Store
Thumbs.db

.vercel
.env*
